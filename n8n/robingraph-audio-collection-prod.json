    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://robingraph-audio-collector:8000/internal/v1/audio/' + $json.request.path }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "timeout": 60000,
          "response": {
            "response": {
