      "id": "7bc81956-b1f4-5028-bb1a-2f80cae07d42",
      "name": "Verify PROD collector health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst health = $input.first().json;\nif (health.deployment_target !== 'prod' || health.publication_enabled !== false) throw new Error('Audio workflow requires prod collector with publication disabled');\nconst c = $('Execution inputs').first().json;\nc.scheduled=$('Scheduled collection inputs').isExecuted===true;\nif (!['collect','status'].includes(c.action)) throw new Error('Unsupported manual action');\nif (!Number.isInteger(c.limit) || c.limit < 1 || c.limit > 5) throw new Error('Batch limit must be 1..5');\nconst s = {action:c.action, queue:[], results:[], next_cursor:null, config:c};\nfunction req(path, body) { return [{json:{state:s, request:{path,body},done:false,wait_seconds:0}}]; }\nif (c.action !== 'collect') {\n  if (!/^[a-f0-9]{64}$/.test(c.candidate_id)) throw new Error('Explicit candidate_id required');\n  const body = {candidate_id:c.candidate_id};\n  return req(c.action, body);\n}\nif (c.file_title && !c.scientific_name) throw new Error('File title requires scientific_name');\nif (c.scientific_name) {\n  s.queue = [{scientific_name:c.scientific_name}];\n  return req(c.file_title ? 'stage':'discover', c.file_title ? {scientific_name:c.scientific_name,file_title:c.file_title}:{scientific_name:c.scientific_name,limit:3});\n}\nreturn req('targets',{limit:c.limit,...(c.after_taxon_id ? {after_taxon_id:c.after_taxon_id}:{})});\n"
      },
      "id": "c06985b1-433e-5338-8fe5-a4ebf2c3eb8b",
      "name": "Initialize request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
