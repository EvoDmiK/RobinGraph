# Copy to .env.nas.ingest on the NAS and set mode 0600. Never commit that file.
# This file is used only by the one-shot nas-tools container, not by the API.
ROBINGRAPH_IMAGE=robingraph-api:local
ROBINGRAPH_EDGE_NETWORK=robingraph-edge
ROBINGRAPH_INGEST_CACHE_VOLUME=robingraph-ingest-cache
ROBINGRAPH_STATE_VOLUME=robingraph-state

# n8n Public API. An internal Docker URL is preferred when n8n shares the edge network.
ROBINGRAPH_N8N_API_URL=http://n8n:5678/api/v1
ROBINGRAPH_N8N_API_KEY=
ROBINGRAPH_N8N_WORKFLOW_ID=
ROBINGRAPH_N8N_REFERENCE_WORKFLOW_ID=
ROBINGRAPH_N8N_AVONET_WORKFLOW_ID=
ROBINGRAPH_N8N_KOREAN_VERNACULAR_WORKFLOW_ID=
ROBINGRAPH_N8N_NEO4J_CREDENTIAL=RobinGraph Neo4j corrected
ROBINGRAPH_N8N_DISCORD_CREDENTIAL=Nesty API 키
ROBINGRAPH_DISCORD_GUILD_ID=1504129603310981120
ROBINGRAPH_DISCORD_CHANNEL_ID=1541317761517756436

# Neo4j Query API used by the verified AVONET batch loader.
ROBINGRAPH_NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
