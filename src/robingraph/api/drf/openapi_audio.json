  "/internal/v1/audio/preview/{candidate_id}": {
    "get": {
      "summary": "Private reviewed-file preview",
      "parameters": [
        {
          "name": "candidate_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "Range",
          "in": "header",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Complete audio"
        },
        "206": {
          "description": "Single byte range"
        },
        "404": {
          "description": "File unavailable or unpublished"
        },
        "416": {
          "description": "Invalid or unsatisfiable byte range"
        }
      },
      "security": [
        {
          "AudioInternalBearer": []
        }
      ]
    },
