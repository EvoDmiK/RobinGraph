{
  "/internal/v1/audio/targets": {
    "post": {
      "summary": "Audio targets",
      "tags": [
        "audio"
      ],
      "security": [
        {
          "AudioInternalBearer": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5,
                  "default": 5
                },
                "after_taxon_id": {
                  "type": "string"
                }
              },
              "required": []
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Operation completed; review and publish are explicit independent decisions"
        },
        "401": {
          "description": "Internal bearer required"
        },
        "409": {
          "description": "State gate, concurrent collection, or changed active source context"
        },
        "422": {
          "description": "Invalid request or unverified source"
        },
        "429": {
          "description": "Provider-wide cooldown; stop the batch and honor Retry-After",
          "headers": {
            "Retry-After": {
              "schema": {
                "type": "integer"
              }
            }
          }
        },
        "502": {
          "description": "Provider unavailable; no publication"
        }
      }
    }
  },
