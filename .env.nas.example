# Docker Compose settings. Copy this file to .env.nas on the NAS and keep the
# populated file outside Git.
ROBINGRAPH_ENV_FILE=.env.nas
ROBINGRAPH_EDGE_NETWORK=robingraph-edge
ROBINGRAPH_IMAGE=robingraph-api:local
ROBINGRAPH_INGEST_CACHE_VOLUME=robingraph-ingest-cache
ROBINGRAPH_STATE_VOLUME=robingraph-state

# Start with serve-fixture to validate Docker, NPM and Swagger. Change to
# serve-neo4j only after the Neo4j values below have been verified.
ROBINGRAPH_API_MODE=serve-fixture

# Required only for serve-neo4j. The Neo4j container must be attached to the
# edge network if its container name is used here.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required when /v1/search uses hybrid mode. Full-text mode works without it.
ROBINGRAPH_JINA_ENDPOINT=https://embed.dove-nest.com/v1/embeddings
ROBINGRAPH_JINA_API_FORMAT=birdsnest
ROBINGRAPH_JINA_MODEL=jinaai/jina-embeddings-v3
ROBINGRAPH_JINA_DIMENSIONS=512
ROBINGRAPH_JINA_NORMALIZED=true
ROBINGRAPH_JINA_API_KEY=
ROBINGRAPH_JINA_BATCH_SIZE=32
ROBINGRAPH_JINA_TIMEOUT_SECONDS=120
ROBINGRAPH_JINA_MAX_LENGTH=1024
ROBINGRAPH_JINA_MAX_RETRIES=2
