# Docker Compose settings. Copy this file to .env.nas on the NAS and keep the
# populated file outside Git.
ROBINGRAPH_ENV_FILE=.env.nas
ROBINGRAPH_EDGE_NETWORK=robingraph-edge
ROBINGRAPH_IMAGE=robingraph-api:local
ROBINGRAPH_INGEST_CACHE_VOLUME=robingraph-ingest-cache
ROBINGRAPH_STATE_VOLUME=robingraph-state

# Start with serve-fixture to validate Docker, NPM and Swagger. Change to
# serve-neo4j only after the Neo4j values below have been verified.
ROBINGRAPH_API_MODE=serve-fixture

# Required only for serve-neo4j. The Neo4j container must be attached to the
# edge network if its container name is used here.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required by serve-neo4j for the reference-taxonomy lineage context.
# Use the matching TEST or PROD PostgreSQL database in each target file.
ROBINGRAPH_PG_HOST=
ROBINGRAPH_PG_PORT=5432
ROBINGRAPH_PG_DATABASE=
ROBINGRAPH_PG_SCHEMA=ingest
ROBINGRAPH_PG_USERNAME=
ROBINGRAPH_PG_PASSWORD=
ROBINGRAPH_PG_SSLMODE=prefer

# Required when /v1/search uses hybrid mode. Full-text mode works without it.
# On the NAS, call the Mac mini embedding server over the LAN. The public
# https://embed.dove-nest.com endpoint routes through Cloudflare and adds ~0.5s per call.
ROBINGRAPH_JINA_ENDPOINT=http://192.168.219.98:8765/v1/embeddings
ROBINGRAPH_JINA_API_FORMAT=birdsnest
ROBINGRAPH_JINA_MODEL=jinaai/jina-embeddings-v3
ROBINGRAPH_JINA_DIMENSIONS=512
ROBINGRAPH_JINA_NORMALIZED=true
ROBINGRAPH_JINA_API_KEY=
ROBINGRAPH_JINA_BATCH_SIZE=32
ROBINGRAPH_JINA_TIMEOUT_SECONDS=120
ROBINGRAPH_JINA_MAX_LENGTH=1024
ROBINGRAPH_JINA_MAX_RETRIES=2

# Server-side Jev routing; put the key in the selected .env.nas.test/.prod.
# TYPESAFE_API_KEY is accepted for compatibility; JEV_API_KEY takes precedence.
JEV_API_KEY=
ROBINGRAPH_INTENT_ROUTER=auto
ROBINGRAPH_JEV_ENDPOINT=https://thejevai.com/v1/systemone
ROBINGRAPH_JEV_MODEL=typesafe/jev-1.13
ROBINGRAPH_JEV_TIMEOUT_SECONDS=8
ROBINGRAPH_JEV_MAX_RETRIES=1
ROBINGRAPH_JEV_CONFIDENCE_THRESHOLD=0.85
ROBINGRAPH_JEV_PROBABILITY_THRESHOLD=0.80
ROBINGRAPH_JEV_MARGIN_THRESHOLD=0.20

# Optional: generate /v1/chat evidence answers with Gemini after retrieval.
GEMINI_API_KEY=
ROBINGRAPH_GEMINI_MODEL=gemini-3.8-flash

# Optional: MLflow tracing for retrieval/generation flows on NAS.
# Disabled by default. When enabled, RobinGraph sends traces over HTTPS.
ROBINGRAPH_MLFLOW_TRACING=false
MLFLOW_TRACKING_URI=https://mlflow.dove-nest.com
MLFLOW_EXPERIMENT_NAME=robingraph
# MLFLOW_EXPERIMENT_ID=
# MLFLOW_HTTP_REQUEST_TIMEOUT=10
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
