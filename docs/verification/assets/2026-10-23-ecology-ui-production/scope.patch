diff --git a/src/robingraph/api/static/styles.css b/src/robingraph/api/static/styles.css
index 6128892..a10470d 100644
--- a/src/robingraph/api/static/styles.css
+++ b/src/robingraph/api/static/styles.css
@@ -1781,3 +1781,26 @@ body:has(.species-popup[open]) { overflow: hidden; }
     grid-template-columns: minmax(0, 1fr);
   }
 }
+
+/* Focused ecological replies share the existing comparison controls. */
+.species-question-answer[data-ecological="true"] { margin-top: 1rem; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 1rem; background: var(--color-surface); }
+.species-question-answer[data-ecological="true"] > h3 { margin: 0 0 1rem; font-size: 1.15rem; line-height: 1.5; }
+.species-ecological-related[data-inline="true"] { margin: 0; padding: 0; border: 0; }
+.species-ecological-related[data-inline="true"] [role="status"]:empty { display: none; }
+.species-ecological-related[data-inline="true"] .ecological-group + .ecological-group { margin-top: 1.25rem; }
+.species-ecological-related[data-inline="true"] h3 { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .65rem; margin: 0 0 .7rem; font-size: .85rem; font-weight: 500; color: var(--color-muted); }
+.ecological-category { padding: .25rem .6rem; border-radius: 999px; background: var(--color-answer-bg); color: var(--color-accent); font-weight: 700; }
+.species-ecological-related[data-inline="true"] .ecological-peer { margin: .45rem 0; padding: .75rem .85rem; border-color: var(--color-border); background: var(--color-bg); }
+.species-ecological-related[data-inline="true"] .comparison-peer-identity strong { font-size: 1rem; color: var(--color-text); text-transform: none; }
+.species-ecological-related[data-inline="true"] button.comparison-peer-choose { grid-row: 1; background: var(--color-surface); color: var(--color-accent); border-color: var(--color-answer-border); padding-inline: .8rem; }
+.species-ecological-related[data-inline="true"] .ecological-group > .ecological-source { margin-top: .75rem; color: var(--color-muted); }
+.species-ecological-related[data-inline="true"] .ecological-source summary { cursor: pointer; min-height: 32px; display: list-item; }
+.species-ecological-related[data-inline="true"] .ecological-source summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
+.species-ecological-related[data-inline="true"] .ecological-source .ecological-source { padding-left: .75rem; border-left: 2px solid var(--color-border); }
+.species-ecological-related[data-inline="true"] .species-note { margin: 1rem 0 0; padding-top: .8rem; border-top: 1px solid var(--color-border); font-size: .8rem; line-height: 1.65; color: var(--color-muted); }
+.species-popup-entry[data-ecological-reference="true"] > .species-popup-trigger { margin: .6rem 0 0; padding: .45rem .6rem; border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-accent); font-size: .8rem; min-height: 44px; }
+@media (max-width: 480px) {
+  .species-question-answer[data-ecological="true"] { padding: .85rem; }
+  .species-ecological-related[data-inline="true"] .ecological-peer { padding: .65rem; gap: .4rem; }
+  .species-ecological-related[data-inline="true"] button.comparison-peer-choose { padding-inline: .55rem; font-size: .85rem; }
+}
