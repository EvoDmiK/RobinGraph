+                                key=lambda c: (c['trait_name'], c['op'], c['value'] or '',
+                                               c['threshold'] or 0, c['unit'] or '', c['qualifier'] or ''))
+    for condition in plan['conditions']:
+        if condition['threshold'] is not None:
+            condition['threshold'] = float(condition['threshold'])
+    return plan
