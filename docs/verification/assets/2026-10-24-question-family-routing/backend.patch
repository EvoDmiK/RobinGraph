+def canonical_graph_plan(question, intent):
+    """Comparable executable query values, without source wording/spans or provider diagnostics.
+
+    Names remain unresolved source names: aliases are NOT equated here. Compare resolved IDs after execution.
+    Numeric thresholds use the validated query's units; tree-fruit qualification and trophic niche stay distinct.
+    """
+    if execution_gate(question, intent) != 'answer':
+        return None
+    query = to_graph_question(question, intent)
+    plan = asdict(query)
+    plan['names'] = sorted(query.names) if query.kind == 'common_taxonomy' else list(query.names)
+    if query.kind == 'order_fruit':
+        from .graph_condition_extractor import _DIET_CONDITIONS
+        plan.update(kind='taxon_traits', criterion=None, conditions=[asdict(_DIET_CONDITIONS[query.criterion])])
+    elif query.kind == 'habitat_shared_diet':
+        plan.update(kind='shared_diet', habitat=None,
+                    conditions=[asdict(TraitCondition('habitat', 'eq', query.habitat))])
