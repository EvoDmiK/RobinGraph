+def _condition_detail(question: str, spans) -> str:
+    """Quote only source-verified spans, joining adjacent pieces of one phrase."""
+    ranges = sorted({(s.start, s.end) for s in spans
+                     if 0 <= s.start < s.end <= len(question) and question[s.start:s.end] == s.text})
+    merged = []
+    for start, end in ranges:
+        if merged and (start <= merged[-1][1] or not question[merged[-1][1]:start].strip()):
+            merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
+        else:
+            merged.append((start, end))
+    return ", ".join(f"‘{question[start:end]}’" for start, end in merged[:3])
+
+
