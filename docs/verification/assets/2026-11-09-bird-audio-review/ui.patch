+.review-facts dd { margin: 0; font-size: .93rem; }
+.review-card :is(h3, p, dd, a) { overflow-wrap: anywhere; }
+.review-card a { color: var(--color-accent); text-underline-offset: 3px; }
+.review-player { display: grid; gap: .6rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
+.review-player .clear-button { justify-self: start; }
+.review-player audio { display: block; width: 100%; min-width: 0; }
+.review-player-status { font-size: .85rem; color: var(--color-muted); }
+.review-more { justify-self: center; min-width: 150px; }
+.review-empty { text-align: center; padding: 2.5rem 1rem; color: var(--color-muted); background: var(--color-surface); border: 1px dashed var(--color-border); border-radius: 18px; }
+.review-status[data-error="true"] { color: var(--color-error-text); }
+@media (max-width: 540px) {
+  .audio-review-page { padding: 1.25rem 1rem; gap: 1.1rem; }
+  .review-access, .review-card { padding: 1rem; }
+  .review-facts { grid-template-columns: minmax(0, 1fr); gap: .7rem; }
+  .review-card-header { flex-wrap: wrap; }
+  .review-filter { width: 100%; justify-content: space-between; }
+  .review-filter select { flex: 1; max-width: 210px; }
+  .review-connect-actions { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
