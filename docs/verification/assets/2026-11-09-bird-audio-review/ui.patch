+.review-access { display: grid; gap: 1rem; }
+.review-access h2, .review-toolbar h2 { font-size: 1.15rem; }
+.review-access p, .review-boundary, .review-status { color: var(--color-muted); font-size: .9rem; }
+.review-access p { margin-top: .4rem; max-width: 65ch; }
+#review-connect-form { display: grid; gap: .45rem; }
+.review-connect-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
+.audio-review-page input, .audio-review-page select { font: inherit; padding: .65rem .8rem; background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border); border-radius: 10px; min-width: 0; }
+#review-key { flex: 1; }
+.audio-review-page button { min-height: 44px; }
+.audio-review-page :is(button, input, select, a, audio):focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
+.review-library { display: grid; gap: 1rem; }
+.review-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
+.review-filter { display: flex; align-items: center; gap: .7rem; }
+.review-filter label { font-size: .85rem; color: var(--color-muted); }
+.review-boundary { padding: .85rem 1rem; background: var(--color-answer-bg); border-left: 3px solid var(--color-answer-border); border-radius: 0 10px 10px 0; }
+.review-candidates { display: grid; gap: 1rem; }
+.review-card { display: grid; gap: 1rem; min-width: 0; }
+.review-card-header { display: flex; align-items: start; gap: .7rem; justify-content: space-between; }
+.review-card-heading { min-width: 0; }
+.review-card h3 { font-size: 1.15rem; }
+.review-scientific { color: var(--color-muted); font-size: .9rem; font-style: italic; }
+.review-card-subtitle { font-size: .85rem; color: var(--color-muted); margin-top: .2rem !important; }
+.review-badge { background: var(--color-abstain-bg); color: var(--color-warning); border: 1px solid var(--color-abstain-border); font-size: .78rem; font-weight: 700; padding: .3rem .65rem; border-radius: 999px; flex-shrink: 0; }
+.review-badge-reviewed { background: var(--color-answer-bg); color: var(--color-accent); border-color: var(--color-answer-border); }
+.review-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 1.5rem; margin: 0; }
+.review-fact { min-width: 0; }
