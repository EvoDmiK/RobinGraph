--- a/src/robingraph/api/static/styles.css
+++ b/src/robingraph/api/static/styles.css
@@ -2168,9 +2168,18 @@
 
 .species-recording { margin-block: .65rem; overflow-wrap: anywhere; }
 .species-recording p { margin-block: .35rem; font-size: .78rem; }
-.species-recording-audio { display: block; width: 100%; min-width: 0; color-scheme: light; background: #e3f2c4; border-radius: 999px; }
-.species-recording-audio::-webkit-media-controls-panel { background-color: #e3f2c4; }
-.species-recording-audio:focus-visible { outline: 2px solid #233d1c; outline-offset: 3px; }
+/* Keep native controls light; EX uses its card face rather than its dark badge. */
+.species-card { --recording-surface: #f1f2ee; --recording-focus: #20351d; }
+.species-card.risk-lc { --recording-surface: #e3f2c4; --recording-focus: #233d1c; }
+.species-card.risk-nt { --recording-surface: #d3efe3; --recording-focus: #12382c; }
+.species-card.risk-vu { --recording-surface: #fbeab0; --recording-focus: #3f2c00; }
+.species-card.risk-en { --recording-surface: #fdd9bd; --recording-focus: #431800; }
+.species-card.risk-cr { --recording-surface: #fcd3df; --recording-focus: #43001a; }
+.species-card.risk-ew { --recording-surface: #e4d8fa; --recording-focus: #1e0b4a; }
+.species-card.risk-ex { --recording-surface: #ecebf1; --recording-focus: #3b3b44; }
+.species-recording-audio { display: block; width: 100%; min-width: 0; color-scheme: light; background: var(--recording-surface, #f1f2ee); border-radius: 999px; }
+.species-recording-audio::-webkit-media-controls-panel { background-color: var(--recording-surface, #f1f2ee); }
+.species-recording-audio:focus-visible { outline: 2px solid var(--recording-focus, #20351d); outline-offset: 3px; }
 
 .species-recording-controls { margin-block: .5rem; }
 .species-recording-source-link { display: block; margin: .2rem 0 .45rem auto; padding: .25rem .4rem; font: inherit; font-size: .72rem; color: inherit; background: transparent; border: 0; text-decoration: underline; cursor: pointer; }
