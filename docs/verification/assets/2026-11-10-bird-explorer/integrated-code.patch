+                peer_row(2, 'Beta two', [habitat(), diet(30, 20), diet(30, 20)], counts=counts),
+                peer_row(3, 'Gamma three', [habitat(), diet(20, 10), diet(20, 10)], counts=counts)]
+        repo = Repo(rows, TAXA)
