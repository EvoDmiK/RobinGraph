# Do not commit a populated .env file. Internal URIs and credentials belong in
# the deployment secret store or a local environment only.
NEO4J_URI=bolt://neo4j.example.internal:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# n8n Public API deployment. Keep the API key only in the untracked .env.
ROBINGRAPH_N8N_API_URL=https://n8n.example.com/api/v1
ROBINGRAPH_N8N_API_KEY=
ROBINGRAPH_N8N_WORKFLOW_ID=
ROBINGRAPH_N8N_REFERENCE_WORKFLOW_ID=
ROBINGRAPH_N8N_AVONET_WORKFLOW_ID=
ROBINGRAPH_N8N_NEO4J_CREDENTIAL=Neo4j
ROBINGRAPH_N8N_DISCORD_CREDENTIAL=Nesty API 키

# Explicitly configure your Jina-compatible server before using --embeddings/--hybrid.
# BirdsNest service contract: API-USAGE.md supplied by the operator.
ROBINGRAPH_JINA_ENDPOINT=https://embed.dove-nest.com/v1/embeddings
ROBINGRAPH_JINA_API_FORMAT=birdsnest
ROBINGRAPH_JINA_MODEL=jinaai/jina-embeddings-v3
ROBINGRAPH_JINA_DIMENSIONS=512
ROBINGRAPH_JINA_NORMALIZED=true
ROBINGRAPH_JINA_API_KEY=
ROBINGRAPH_JINA_BATCH_SIZE=32
ROBINGRAPH_JINA_TIMEOUT_SECONDS=120
ROBINGRAPH_JINA_MAX_LENGTH=1024
ROBINGRAPH_JINA_MAX_RETRIES=2
