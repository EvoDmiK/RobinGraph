{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RobinGraph collection points",
  "type": "object",
  "required": ["registry_version", "selected_design", "collection_points"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "selected_design": {"const": "terra-claim-first"},
    "collection_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "collection_point_id", "source_id", "source_release", "scope", "role", "endpoint_uri",
          "payload_mode", "evidence_kind", "score", "enabled", "license_policy_status",
          "target_entities"
        ],
        "properties": {
          "collection_point_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "source_release": {"type": "string", "minLength": 1},
          "scope": {"enum": ["taxonomy", "traits", "habitat", "vegetation", "conservation"]},
          "role": {"type": "string", "minLength": 1},
          "endpoint_uri": {"type": "string", "format": "uri"},
          "payload_mode": {"enum": ["source_snapshot", "structured_claim", "spatial_inference", "link_only"]},
          "evidence_kind": {"enum": ["direct", "literature", "spatial_inference"]},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "enabled": {"type": "boolean"},
          "license_policy_status": {"enum": ["allowed", "restricted", "review_required", "denied"]},
          "target_entities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
